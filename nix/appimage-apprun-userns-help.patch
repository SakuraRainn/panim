The second patch of the AppRun of nix-appimage (`appruns/userns-chroot/main.c`, rev 28b2101). Apply it after
`nix/appimage-apprun-store.patch`. Refer to `docs/ARCHITECTURE.md` §11 and `README.md`, "Ubuntu 24.04 and later".

The AppRun must make a user namespace. Some systems do not let a normal user make one. For example, Ubuntu 24.04
and later block them with AppArmor (`kernel.apparmor_restrict_unprivileged_userns = 1`). Without this patch, the
AppRun stops with "cannot unshare: Operation not permitted", and the message does not tell the cause.

This patch keeps the first error line. Then it tells the cause and what to do:

- If `/proc/sys/kernel/apparmor_restrict_unprivileged_userns` is 1, it tells how to add an AppArmor profile for the
  AppImage. If the path in `$APPIMAGE` has no quote and no pattern character, it shows the profile with this path.
- If not, it tells the person to ask the administrator to allow the namespaces.
- It also tells that the Nix package operates, and that `--appimage-extract-and-run` does not help, because the
  runtime then starts the same AppRun.

The text shows when `unshare` fails, when a write to `uid_map`, `setgroups` or `gid_map` fails, and when the mount
of the tmpfs fails with EPERM or EACCES (a namespace with no capabilities). The other errors do not change. This
patch is separate from the store patch, so that PANIM can remove the store patch when nix-appimage fixes the bind.

--- a/main.c
+++ b/main.c
@@ -41,6 +41,79 @@
 	}
 }
 
+/* PANIM: the help text for a system that does not let a normal user make a user namespace. For example,
+ * Ubuntu 24.04 and later block them with AppArmor. Refer to `README.md` of PANIM, "Ubuntu 24.04 and later". */
+#define PANIM_HELP_URL "https://github.com/SakuraRainn/panim#ubuntu-2404-and-later"
+
+/* True if AppArmor blocks unprivileged user namespaces (the sysctl of Ubuntu 23.10 and later). */
+static bool apparmor_blocks_userns(void)
+{
+	char value = 0;
+	int fd = open("/proc/sys/kernel/apparmor_restrict_unprivileged_userns", O_RDONLY);
+	if (fd < 0) {
+		return false;
+	}
+	ssize_t n = read(fd, &value, 1);
+	close(fd);
+	return n == 1 && value == '1';
+}
+
+/* True if the profile can name this path without a quote or an AppArmor pattern character. */
+static bool path_fits_profile(const char* path)
+{
+	if (!path || path[0] != '/') {
+		return false;
+	}
+	for (const char* c = path; *c; c++) {
+		if (*c < 0x20 || *c == 0x7f || strchr("\"\\*?[]{}^", *c)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void userns_help(int err)
+{
+	fprintf(stderr, "\nPANIM cannot start. The AppImage must make a user namespace, and this system does not let a\n");
+	fprintf(stderr, "normal user make one (%s).\n", strerror(err));
+	fprintf(stderr, "\nDo one of these:\n");
+	if (apparmor_blocks_userns()) {
+		fprintf(stderr, "  1. AppArmor blocks user namespaces (kernel.apparmor_restrict_unprivileged_userns = 1), as on\n");
+		fprintf(stderr, "     Ubuntu 24.04 and later. Add an AppArmor profile that lets only this AppImage make them.\n");
+		const char* appimage = getenv("APPIMAGE");
+		if (path_fits_profile(appimage)) {
+			fprintf(stderr, "     Run these commands, then start the AppImage again:\n\n");
+			fprintf(stderr, "sudo tee /etc/apparmor.d/panim <<'EOF'\n");
+			fprintf(stderr, "abi <abi/4.0>,\n");
+			fprintf(stderr, "include <tunables/global>\n");
+			fprintf(stderr, "profile panim \"%s\" flags=(unconfined) {\n", appimage);
+			fprintf(stderr, "  userns,\n");
+			fprintf(stderr, "  include if exists <local/panim>\n");
+			fprintf(stderr, "}\n");
+			fprintf(stderr, "EOF\n");
+			fprintf(stderr, "sudo apparmor_parser -r /etc/apparmor.d/panim\n\n");
+			fprintf(stderr, "     If you move or rename the AppImage, change the path in the profile.\n");
+		}
+	} else {
+		fprintf(stderr, "  1. Ask the administrator of the system to allow unprivileged user namespaces. For example,\n");
+		fprintf(stderr, "     user.max_user_namespaces = 0 or kernel.unprivileged_userns_clone = 0 blocks them.\n");
+	}
+	fprintf(stderr, "  2. Install PANIM with Nix: nix run github:SakuraRainn/panim\n");
+	fprintf(stderr, "The option --appimage-extract-and-run does not help. It starts this same step.\n");
+	fprintf(stderr, "The full steps: %s\n", PANIM_HELP_URL);
+}
+
+/* As die_if, and then the help text of PANIM. */
+static void die_userns_if(bool cond, const char* what)
+{
+	if (cond) {
+		int err = errno;
+		fprintf(stderr, "%s: %s: %s\n", argv0, what, strerror(err));
+		userns_help(err);
+		exit(EXIT_EXECERROR);
+	}
+}
+
 const char* strprintf(const char* fmt, ...)
 {
 	va_list args1;
@@ -103,7 +176,7 @@
 	}
 
 	// Create new mount namespace (and potentially user namespace if not root)
-	die_if(unshare(clonens) < 0, "cannot unshare");
+	die_userns_if(unshare(clonens) < 0, "cannot unshare");
 
 	if (uid != 0) {
 		// UID/GID Mapping -----------------------------------------------------------
@@ -112,20 +185,24 @@
 		// > The data written to uid_map (gid_map) must consist of a single line that
 		// > maps the writing process's effective user ID (group ID) in the parent
 		// > user namespace to a user ID (group ID) in the user namespace.
-		die_if(write_to("/proc/self/uid_map", "%d %d 1\n", uid, uid), "cannot write uid_map");
+		die_userns_if(write_to("/proc/self/uid_map", "%d %d 1\n", uid, uid), "cannot write uid_map");
 
 		// see user_namespaces(7):
 		// > In the case of gid_map, use of the setgroups(2) system call must first
 		// > be denied by writing "deny" to the /proc/[pid]/setgroups file (see
 		// > below) before writing to gid_map.
-		die_if(write_to("/proc/self/setgroups", "deny"), "cannot write setgroups");
-		die_if(write_to("/proc/self/gid_map", "%d %d 1\n", uid, gid), "cannot write gid_map");
+		die_userns_if(write_to("/proc/self/setgroups", "deny"), "cannot write setgroups");
+		die_userns_if(write_to("/proc/self/gid_map", "%d %d 1\n", uid, gid), "cannot write gid_map");
 	}
 
 	// Mountpoint ----------------------------------------------------------------
 
 	// tmpfs so we don't need to cleanup
-	die_if(mount("tmpfs", mountroot, "tmpfs", 0, 0) < 0, "mount tmpfs -> %s", mountroot);
+	if (mount("tmpfs", mountroot, "tmpfs", 0, 0) < 0) {
+		// PANIM: a namespace with no capabilities (AppArmor on Ubuntu) refuses the mount with EPERM.
+		die_userns_if(errno == EPERM || errno == EACCES, "cannot mount tmpfs");
+		die_if(true, "mount tmpfs -> %s", mountroot);
+	}
 	// make unbindable to both prevent event propagation as well as mount explosion
 	die_if(mount(mountroot, mountroot, "none", MS_UNBINDABLE, 0) < 0, "mount tmpfs bind -> %s", mountroot);
 
