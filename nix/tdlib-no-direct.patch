--- a/tdnet/td/net/GetHostByNameActor.cpp
+++ b/tdnet/td/net/GetHostByNameActor.cpp
@@ -113,7 +113,12 @@
   void start_up() final {
     IPAddress ip;
     auto begin_time = Time::now();
-    auto status = ip.init_host_port(host_, 0, prefer_ipv6_);
+    // PANIM: accept only an IP address. Do not ask the resolver of the system for a host name.
+    auto r_ip = IPAddress::get_ip_address(host_);
