{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window only. It can call all commands except page_notice. It loads only the local pages of the app.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "allow-status",
    "allow-set-settings",
    "allow-create",
    "allow-unlock",
    "allow-recover",
    "allow-recover-with-words",
    "allow-recovery-words",
    "allow-check-words",
    "allow-export-key-file",
    "allow-change-passcode",
    "allow-lock",
    "allow-set-route",
    "allow-accounts",
    "allow-add-browser-account",
    "allow-remove-account",
    "allow-timeline",
    "allow-open-account",
    "allow-unread",
    "allow-github-login-start",
    "allow-github-login-poll",
    "allow-github-login-cancel",
    "allow-open-github-login",
    "allow-open-link",
    "allow-sync-now",
    "allow-sync-state",
    "allow-set-read",
    "allow-answer",
    "allow-check-github-proof",
    "allow-proofs",
    "allow-make-proof",
    "allow-set-identity",
    "allow-set-proof-location",
    "allow-check-own-proof",
    "allow-check-pasted-proof",
    "allow-open-gist-page",
