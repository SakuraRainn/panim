    "allow-telegram-login-phone",
    "allow-telegram-login-code",
    "allow-telegram-login-password",
    "allow-telegram-login-resend",
    "allow-telegram-login-cancel",
    "allow-telegram-chat-open",
    "allow-telegram-chat",
    "allow-telegram-chat-close",
    "allow-telegram-app",
    "allow-set-telegram-app",
    "allow-forget-telegram-app",
    "allow-backup-vault",
    "allow-restore-vault"
  ]
}
